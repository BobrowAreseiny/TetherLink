<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Исходники ядра компилируем прямо здесь: отдельная ProxyBridge.Core.dll
         на этой машине блокируется антивирусом при загрузке. -->
    <Compile Include="..\..\ProxyBridge.Core\**\*.cs" Exclude="..\..\ProxyBridge.Core\bin\**;..\..\ProxyBridge.Core\obj\**" />
  </ItemGroup>
</Project>
