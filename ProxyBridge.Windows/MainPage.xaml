<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProxyBridge.Windows.ViewModels"
             xmlns:controls="clr-namespace:ProxyBridge.Windows.Controls"
             x:Class="ProxyBridge.Windows.MainPage"
             x:DataType="vm:ProxyViewModel"
             BackgroundColor="{StaticResource PbBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Шапка -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="26,18,26,6">
            <Border WidthRequest="44" HeightRequest="44" Padding="8"
                    BackgroundColor="{StaticResource PbSurfaceAlt}"
                    Stroke="{StaticResource PbStroke}" StrokeThickness="1">
                <Image Source="logo.png" Aspect="AspectFit" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="TetherLink" Style="{StaticResource PbTitle}" FontSize="21" />
                <Label Text="подключение через телефон" Style="{StaticResource PbSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="⟳" FontSize="19"
                    BackgroundColor="{StaticResource PbSurfaceAlt}"
                    TextColor="{StaticResource PbText}"
                    BorderColor="{StaticResource PbStroke}" BorderWidth="1"
                    CornerRadius="0" HeightRequest="42" WidthRequest="42"
                    Padding="0" Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="26,14,26,26" Spacing="18"
                                 MaximumWidthRequest="620" HorizontalOptions="Center">

                <!-- Кнопка питания -->
                <VerticalStackLayout Spacing="4">
                    <Grid WidthRequest="270" HeightRequest="270" HorizontalOptions="Center">
                        <!-- Свечение: радиальный градиент внутри макета, чтобы его
                             не обрезала верхняя кромка ScrollView. -->
                        <Border WidthRequest="270" HeightRequest="270" StrokeThickness="0"
                                Opacity="{Binding PowerGlowOpacity}" InputTransparent="True">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                    <GradientStop Color="#003ED598" Offset="0.60" />
                                    <GradientStop Color="#553ED598" Offset="0.79" />
                                    <GradientStop Color="#003ED598" Offset="1.0" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border WidthRequest="190" HeightRequest="190" Padding="0"
                                StrokeThickness="2" Stroke="{Binding PowerStroke}"
                                BackgroundColor="{StaticResource PbSurface}"
                                StrokeShape="RoundRectangle 95" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding PowerText}" FontSize="18" FontAttributes="Bold"
                                       TextColor="{Binding PowerTextColor}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PowerSubText}" FontSize="11" TextColor="{StaticResource PbMuted}"
                                       HorizontalTextAlignment="Center" Margin="8,0" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,2,0,0">
                        <Border Style="{StaticResource PbChip}">
                            <Label Text="{Binding ModeName}" Style="{StaticResource PbAccentValue}" />
                        </Border>
                        <Border Style="{StaticResource PbChip}">
                            <Label Text="{Binding Endpoint}" Style="{StaticResource PbAccentValue}" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding DetailText}" Style="{StaticResource PbSubtitle}"
                           HorizontalTextAlignment="Center" Margin="12,10,12,0" />
                </VerticalStackLayout>

                <!-- Настройки -->
                <Border Style="{StaticResource PbCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="НАСТРОЙКИ" Style="{StaticResource PbCaption}" />

                        <Grid ColumnDefinitions="*,132" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Порт" Style="{StaticResource PbValue}" />
                                <Label Text="тот же, что на телефоне" Style="{StaticResource PbSubtitle}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource PbField}">
                                <Entry Text="{Binding PortText}" Keyboard="Numeric"
                                       HorizontalTextAlignment="Center" Style="{StaticResource PbEntryInner}" />
                            </Border>
                        </Grid>

                        <BoxView Style="{StaticResource PbDivider}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Системный прокси Windows" Style="{StaticResource PbValue}" />
                                <Label Text="браузеры и приложения подхватят сразу" Style="{StaticResource PbSubtitle}" />
                            </VerticalStackLayout>
                            <controls:PbToggle Grid.Column="1" IsToggled="{Binding SetSystemProxy}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Переменные HTTP_PROXY / HTTPS_PROXY" Style="{StaticResource PbValue}" />
                                <Label Text="нужно opencode, git, npm, docker" Style="{StaticResource PbSubtitle}" />
                            </VerticalStackLayout>
                            <controls:PbToggle Grid.Column="1" IsToggled="{Binding SetEnvironmentProxy}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Закрывать сессию OpenCode" Style="{StaticResource PbValue}" />
                                <Label Text="при смене прокси — новый запуск подхватит настройки" Style="{StaticResource PbSubtitle}" />
                            </VerticalStackLayout>
                            <controls:PbToggle Grid.Column="1" IsToggled="{Binding CloseOpencodeSession}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Переподключаться сам" Style="{StaticResource PbValue}" />
                                <Label Text="если кабель/USB уснул — связь вернётся сама" Style="{StaticResource PbSubtitle}" />
                            </VerticalStackLayout>
                            <controls:PbToggle Grid.Column="1" IsToggled="{Binding AutoReconnect}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Единственный путь — точка доступа телефона -->
                <Border Style="{StaticResource PbCardFlat}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="ТЕЛЕФОН В ТОЧКЕ ДОСТУПА" Style="{StaticResource PbCaption}" />

                        <Grid ColumnDefinitions="*,170" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="IP телефона в сети" Style="{StaticResource PbValue}" />
                                <Label Text="находится сам по шлюзу Wi-Fi" Style="{StaticResource PbSubtitle}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource PbField}">
                                <Entry Text="{Binding PhoneIp}" Keyboard="Numeric"
                                       HorizontalTextAlignment="Center" Style="{StaticResource PbEntryInner}" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding CheckResultText}" Style="{StaticResource PbSubtitle}"
                               LineBreakMode="TailTruncation" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="Проверить" Command="{Binding CheckPhoneCommand}"
                                    Style="{StaticResource PbGhostButton}" FontSize="13" HeightRequest="40" Padding="0" />
                            <Button Grid.Column="1" Text="Сети Wi-Fi" Command="{Binding OpenWifiSettingsCommand}"
                                    Style="{StaticResource PbGhostButton}" FontSize="13" HeightRequest="40" Padding="0" />
                            <Button Grid.Column="2" Text="Сброс сети" Command="{Binding ResetNetworkCommand}"
                                    Style="{StaticResource PbDangerButton}" FontSize="13" HeightRequest="40" Padding="0" />
                        </Grid>
                        <Label Text="«Сброс сети» выключает системный прокси, убирает переменные окружения
                               (для opencode/git) и чистит DNS-кэш. После сброса запустите opencode заново."
                               Style="{StaticResource PbSubtitle}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Журнал -->
                <Border Style="{StaticResource PbCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ЖУРНАЛ" Style="{StaticResource PbCaption}" />
                        <Label Text="{Binding LogText}" Style="{StaticResource PbLog}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
